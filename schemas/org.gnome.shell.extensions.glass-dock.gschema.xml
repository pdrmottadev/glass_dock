<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.glass-dock" path="/org/gnome/shell/extensions/glass-dock/">

    <!-- Appearance -->
    <key name="position" type="s">
      <choices>
        <choice value="bottom"/>
        <choice value="left"/>
        <choice value="right"/>
      </choices>
      <default>'bottom'</default>
      <summary>Screen edge the dock is attached to</summary>
    </key>
    <key name="monitor-connector" type="s">
      <default>''</default>
      <summary>Monitor connector (e.g. DP-1); empty for the primary monitor</summary>
    </key>
    <key name="icon-size" type="i">
      <range min="32" max="96"/>
      <default>52</default>
      <summary>Icon size in pixels</summary>
    </key>
    <key name="magnification-enabled" type="b">
      <default>true</default>
      <summary>Magnify icons on hover</summary>
    </key>
    <key name="magnification-size" type="i">
      <range min="32" max="160"/>
      <default>96</default>
      <summary>Maximum magnified icon size in pixels</summary>
    </key>
    <key name="glass-opacity" type="d">
      <range min="0.0" max="1.0"/>
      <default>0.35</default>
      <summary>Glass opacity</summary>
    </key>
    <key name="blur-enabled" type="b">
      <default>true</default>
      <summary>Blur what is behind the dock</summary>
    </key>
    <key name="show-running-indicators" type="b">
      <default>true</default>
      <summary>Show running indicators</summary>
    </key>

    <!-- Behavior -->
    <key name="autohide-mode" type="s">
      <choices>
        <choice value="never"/>
        <choice value="autohide"/>
        <choice value="intellihide"/>
      </choices>
      <default>'never'</default>
      <summary>Auto-hide mode</summary>
    </key>
    <key name="autohide-delay" type="i">
      <range min="0" max="3000"/>
      <default>500</default>
      <summary>Hide delay in milliseconds</summary>
    </key>
    <key name="click-action" type="s">
      <choices>
        <choice value="focus-or-minimize"/>
        <choice value="focus"/>
        <choice value="cycle-windows"/>
      </choices>
      <default>'focus-or-minimize'</default>
      <summary>Action when clicking a focused app with one window</summary>
    </key>
    <key name="multi-window-action" type="s">
      <choices>
        <choice value="previews"/>
        <choice value="expose"/>
        <choice value="cycle-windows"/>
        <choice value="minimize-all"/>
      </choices>
      <default>'previews'</default>
      <summary>Action when clicking a focused app with several windows</summary>
    </key>
    <key name="bounce-on-launch" type="b">
      <default>true</default>
      <summary>Bounce the icon when launching an app</summary>
    </key>
    <key name="show-apps-button" type="b">
      <default>true</default>
      <summary>Show the Applications button</summary>
    </key>

    <!-- Right section -->
    <key name="show-recent-apps" type="b">
      <default>true</default>
      <summary>Show recent apps</summary>
    </key>
    <key name="recent-apps-count" type="i">
      <range min="1" max="10"/>
      <default>3</default>
      <summary>Number of recent apps</summary>
    </key>
    <key name="recent-apps" type="as">
      <default>[]</default>
      <summary>Internal list of recently closed apps</summary>
    </key>
    <key name="show-downloads" type="b">
      <default>true</default>
      <summary>Show the Downloads stack</summary>
    </key>
    <key name="downloads-view" type="s">
      <choices>
        <choice value="fan"/>
        <choice value="grid"/>
      </choices>
      <default>'fan'</default>
      <summary>Downloads stack view</summary>
    </key>
    <key name="show-trash" type="b">
      <default>true</default>
      <summary>Show the Trash</summary>
    </key>
  </schema>
</schemalist>
